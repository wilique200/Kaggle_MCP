# Kaggle credentials — from https://www.kaggle.com/settings/account -> "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Optional: shared secret clients must send as `Authorization: Bearer <token>`
# to reach this MCP server. Strongly recommended since this server can submit
# on your behalf. Leave unset only for local testing.
MCP_BEARER_TOKEN=change_me_to_a_long_random_string

# Port the server listens on (Railway/Render inject PORT automatically)
PORT=3000
